{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Wine Consumption in  Italy",
    "anchor": "start",
    "subtitle": "Population over 11 consuming wine, %  | Source: Istat through ECO-API",
    "fontSize": "14",
    "subtitleFontSize": "12",
    "color": "#000000",
    "subtitleColor": "#000000"
  },
  "height": "250",
  "width": "container",
  "autosize": {"type": "fit", "contains": "padding"},
  "background": "#FAF9F6",
  "view": {"fill": "#FAF9F6", "strokeOpacity": 0},
  "data": {
    "url": "https://api.economicsobservatory.com/ita/wine?vega",
    "format": {"type": "json"}
  },
  "mark": {"type": "line", "color": "#f4134d", "strokeWidth": "2"},
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "axis": {"title": "", "titleColor": "#122B39", "grid": false}
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "axis": {"title": "", "titleColor": "#122B39", "grid": false}
    }
  },
  "config": {}
}
