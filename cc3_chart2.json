{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Share of population unable to keep home adequately warm",
  "title": {
    "text": "Share of population unable to keep home adequately warm",
    "subtitle": "Yearly, % of population",
    "anchor": "start",
    "fontSize": 16
  },
  "height": 300,
  "width": "container",
  "data": {
    "url": "https://raw.githubusercontent.com/vsccunha/vsccunha.github.io/refs/heads/main/eurostat_warm-house_clean.csv"
  },
  "mark": {"type": "line", "point": true},
  "encoding": {
    "x": {
      "field": "TIME_PERIOD",
      "type": "ordinal",
      "title": "",
      "axis": {"labelAngle": 0, "grid": false}
    },
    "y": {
      "field": "OBS_VALUE",
      "type": "quantitative",
      "title": ""
    },
    "color": {
      "field": "geo",
      "type": "nominal",
      "title": "Country",
      "legend": {"labelExpr": "datum.label == 'PT' ? 'Portugal' : 'EU-27'"}
    }
  },
  "config": {
    "axis": {"grid": false}
  }
}
